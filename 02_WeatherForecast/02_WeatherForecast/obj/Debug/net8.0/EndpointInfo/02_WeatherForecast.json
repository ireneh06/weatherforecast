{
  "openapi": "3.0.1",
  "info": {
    "title": "02_WeatherForecast",
    "version": "1.0"
  },
  "paths": {
    "/api/location/city/{cityName}": {
      "get": {
        "tags": [
          "Location"
        ],
        "parameters": [
          {
            "name": "cityName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/weather/city/{longitude}/{latitude}": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "parameters": [
          {
            "name": "longitude",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "latitude",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": { }
}